# Copy to .env and fill in. Never commit real values.
# ENV MUST be set to "prod" or "staging" in any deployment.
# The "local" default uses an insecure SECRET_KEY and turns DEBUG on.
ENV=local
SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
DOMAIN_BASE_URL=
BACKEND_BASE_URL=
API_KEY=
ALLOWED_REQUEST_PER_IP_PER_HOUR=
WEBSITE_PROFIT_PERCENTAGE=20
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
AWS_SQS_URL_FOR_DATA_DUMP_TO_BE_USED_BY_EPOS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
STAFF_EMAIL_ADDRESSES=
STRIPE_API_KEY=
STRIPE_WEBHOOK_ENDPOINT_SECRET=
VAPID_PRIVATE_KEY=
POSTGRESDB_NAME=
POSTGRESDB_USER=
POSTGRESDB_PASS=
DB_HOST=
DB_PORT=
REDIS_URL=redis://localhost:6379/0
IQ_WEBHOOK_URL=
IQ_WEBHOOK_SECRET=
