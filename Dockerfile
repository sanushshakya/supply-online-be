
FROM python:3.11-bullseye

ARG DJANGO_SUPERUSER_USER=admin
ARG DJANGO_SUPERUSER_PASSWORD
ARG DJANGO_SUPERUSER_EMAIL=m18worldfoods@gmail.com
ARG ENV=staging
ARG DB_HOST=localhost
ARG DB_PORT=5432
ARG POSTGRESDB_NAME="default" 
ARG POSTGRESDB_USER="default"
ARG POSTGRESDB_PASS
ARG SECRET_KEY
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_S3_STORAGE_BUCKET_NAME
ARG AWS_SQS_URL_FOR_DATA_DUMP_TO_BE_USED_BY_EPOS
ARG EMAIL_HOST_USER="test-user"
ARG EMAIL_HOST_PASSWORD="test-pwd"
ARG STAFF_EMAIL_ADDRESSES="test@paper2product.co.uk"
ARG STRIPE_API_KEY
ARG STRIPE_WEBHOOK_ENDPOINT_SECRET
ARG ALLOWED_HOSTS
ARG CORS_ALLOWED_ORIGINS
ARG DOMAIN_BASE_URL
ARG BACKEND_BASE_URL
ARG API_KEY



WORKDIR /app

ENV ENV $ENV
ENV DB_HOST $DB_HOST
ENV DB_PORT $DB_PORT
ENV POSTGRESDB_NAME $POSTGRESDB_NAME 
ENV POSTGRESDB_USER $POSTGRESDB_USER
ENV POSTGRESDB_PASS $POSTGRESDB_PASS
ENV SECRET_KEY $SECRET_KEY
ENV AWS_ACCESS_KEY_ID $AWS_ACCESS_KEY_ID
ENV AWS_SECRET_ACCESS_KEY $AWS_SECRET_ACCESS_KEY
ENV AWS_S3_STORAGE_BUCKET_NAME $AWS_S3_STORAGE_BUCKET_NAME
ENV AWS_SQS_URL_FOR_DATA_DUMP_TO_BE_USED_BY_EPOS $AWS_SQS_URL_FOR_DATA_DUMP_TO_BE_USED_BY_EPOS
ENV EMAIL_HOST_USER $EMAIL_HOST_USER
ENV EMAIL_HOST_PASSWORD $EMAIL_HOST_PASSWORD
ENV STAFF_EMAIL_ADDRESSES $STAFF_EMAIL_ADDRESSES
ENV STRIPE_API_KEY $STRIPE_API_KEY
ENV STRIPE_WEBHOOK_ENDPOINT_SECRET $STRIPE_WEBHOOK_ENDPOINT_SECRET
ENV ALLOWED_HOSTS $ALLOWED_HOSTS
ENV CORS_ALLOWED_ORIGINS $CORS_ALLOWED_ORIGINS
ENV DOMAIN_BASE_URL $DOMAIN_BASE_URL
ENV BACKEND_BASE_URL $BACKEND_BASE_URL
ENV API_KEY $API_KEY


# Copy requirements file and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Django application code
COPY . .

# Run collectstatic
RUN python manage.py collectstatic --noinput

# Run migration
RUN python manage.py makemigrations

# Run collectstatic
RUN python manage.py migrate

# Expose the Django application port
EXPOSE 8000

# Command to run the Django application
CMD ["uvicorn", "m18_world_foods_backend.asgi:application", "--host", "0.0.0.0", "--port", "8000"]
